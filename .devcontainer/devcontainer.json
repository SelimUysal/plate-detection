{
  "name": "License Plate Detection",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/app/main.py",
        "frontend/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y tesseract-ocr tesseract-ocr-eng libgl1 libglib2.0-0 && pip3 install --user -r backend/requirements.txt && cd frontend && npm install",
  "postAttachCommand": {
    "backend": "cd ${containerWorkspaceFolder} && PYTHONPATH=backend python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "frontend": "cd ${containerWorkspaceFolder}/frontend && npm run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "React frontend",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI backend"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}
